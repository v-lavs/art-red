                                    під ваші потреби.
                                </div>
                                <div class="banner-slide__block-btns">
                                    <a href="#" class="btn btn_white">HoReCa</a>
                                    <a href="#" class="btn btn_stroke">Для дому</a>
                                </div>
                            </div>
                        </div>
                    </li>
                    <li class="splide__slide banner-slide">
