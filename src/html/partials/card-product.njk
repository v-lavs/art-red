
<li class="card-product {% if product.discount_cost is defined and product.discount_cost is not null %}card-product_sale{% endif %}">

    {# Кнопка "Обране" #}
    {#
    <button
            type="button"
            class="btn card-product__favorite {% if product.is_favorite|default(false) %}card-product__favorite--active{% endif %}"
            aria-label="Додати в обране"
    >
        <svg
                width="25"
                height="25"
                viewBox="0 0 25 25"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
        >
            <path
                    d="M12.6038 19.3229L12.4997 19.4271L12.3851 19.3229C7.43718 14.8333 4.16634 11.8646 4.16634 8.85417C4.16634 6.77083 5.72884 5.20833 7.81217 5.20833C9.41634 5.20833 10.9788 6.25 11.5309 7.66667H13.4684C14.0205 6.25 15.583 5.20833 17.1872 5.20833C19.2705 5.20833 20.833 6.77083 20.833 8.85417C20.833 11.8646 17.5622 14.8333 12.6038 19.3229ZM17.1872 3.125C15.3747 3.125 13.6351 3.96875 12.4997 5.29167C11.3643 3.96875 9.62468 3.125 7.81217 3.125C4.60384 3.125 2.08301 5.63542 2.08301 8.85417C2.08301 12.7812 5.62467 16 10.9893 20.8646L12.4997 22.2396L14.0101 20.8646C19.3747 16 22.9163 12.7812 22.9163 8.85417C22.9163 5.63542 20.3955 3.125 17.1872 3.125Z"
                    fill="#78560C"
            />
        </svg>
    </button>
    #}

    {# Бейдж знижки #}
    {% if product.discount is defined and product.discount is not null %}
        <span class="card-product__badge">-{{ product.discount }}%</span>
    {% endif %}

    {# Зображення товару #}
    <a href="{{ product.url }}" class="card-product__img-wrap">
        <img
                src="{{ product.image }}"
                alt="{{ product.title }}"
                class="card-product__img"
        >
    </a>

    {# Назва товару #}
    <a href="{{ product.url }}">
        <h3 class="card-product__title">{{ product.title }}</h3>
    </a>

    {# Категорія / опис #}
    <p class="card-product__text">{{ product.text }}</p>

    {# Бренд #}
    <p class="card-product__brand">
        Бренд: <span>{{ product.brand }}</span>
    </p>

    {# Ціна #}
    <div class="card-product__price-block">
        {% if product.discount_cost is defined and product.discount_cost is not null %}
            <span class="card-product__cost card-product__cost_old">
                {{ product.cost }} ₴
            </span>

            <span class="card-product__cost card-product__cost_new">
                {{ product.discount_cost }} ₴
            </span>
        {% else %}
            <span class="card-product__cost">
                {{ product.cost }} ₴
            </span>
        {% endif %}
    </div>
    <a href="#" class="btn btn_add_to_cart" aria-label="Додати в кошик"><img src="images/icons/cart1.svg" alt="Додати в корзину"></a>
</li>

