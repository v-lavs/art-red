{# Імпортуємо макрос картки товару #}
{% from "partials/cart-item.njk" import cartItem %}

<div class="cart-overlay" id="cart-overlay"></div>

<aside class="cart-drawer" id="cart-drawer">
    <div class="cart-drawer__header">
        <h3>Кошик</h3>
        <button type="button" class="cart-drawer__close" id="cart-close" aria-label="Закрити кошик">×</button>
    </div>

    <div class="cart-drawer__body">
        {# Якщо у нас є товари в масиві — перебираємо їх циклом #}
        {% if cartProducts and cartProducts.length > 0 %}
            {% for product in cartProducts %}
                {{ cartItem(product) }}
                {# Якщо масив порожній — показуємо заглушку #}
            {% endfor %}
        {% else %}
            <div class="cart-drawer__empty">
                <p>Ваш кошик порожній</p>
            </div>
        {% endif %}
    </div>

    <div class="cart-drawer__footer">
        <div class="cart-summary">
            <div class="cart-summary__row">
                <span class="cart-summary__label">Доставка</span>
                <span class="cart-summary__value">по тарифам перевізника</span>
            </div>
            <div class="cart-summary__row cart-summary__row--total">
                <span class="cart-summary__label">Загальна сума замовлення</span>
                <span class="cart-summary__value">{{ cartTotal | default('0') }} ₴</span>
            </div>
        </div>
        <a href="checkout.html" class="btn-checkout">Перейти до оформлення</a>
    </div>
</aside>
